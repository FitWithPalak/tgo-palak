# FitWithPalak — free application funnel
#
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored (see .gitignore -> `.env*.local`) and is NEVER
# committed. On the live deployment these same keys are set in the hosting
# dashboard (Vercel -> Project -> Settings -> Environment Variables), not here.
# Restart `npm run dev` after any change — env vars are read at process start.

# ---------------------------------------------------------------- REQUIRED

# Where the qualifier form POSTs every completed application (both qualified
# and disqualified). Paste the "Webhook URL" from your Pabbly Connect workflow.
# If this is unset the funnel still works, but NO leads are captured.
PABBLY_LEAD_WEBHOOK_URL=

# The scheduler embedded on /book-a-call. Without it the page shows a
# "Loading your calendar" placeholder and nobody can book.
NEXT_PUBLIC_CALENDLY_URL=

# Canonical origin, no trailing slash. Drives page metadata and event URLs.
NEXT_PUBLIC_SITE_URL=https://vsl.palaksachdeva.com


# ---------------------------------------------------------------- CONTENT

# Hero VSL. Accepts a direct file (.mp4/.webm) or a Vimeo/YouTube embed URL.
NEXT_PUBLIC_VSL_URL=

# Testimonial videos opened by the case-study cards.
NEXT_PUBLIC_TESTIMONIAL_1_URL=
NEXT_PUBLIC_TESTIMONIAL_2_URL=
NEXT_PUBLIC_TESTIMONIAL_3_URL=
NEXT_PUBLIC_TESTIMONIAL_4_URL=

# WhatsApp community invite shown on /thank-you. Falls back to a default.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=


# -------------------------------------------------------------- ANALYTICS
# All optional — each block simply does not render when its ID is absent.

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Meta — the FREE funnel has its OWN dedicated dataset/pixel, separate from the
# paid funnel (different objective: leads, not purchases). Put the free dataset's
# pixel here for the browser Pixel (PageView), and below for the CAPI events.
NEXT_PUBLIC_META_PIXEL_ID=

# Server-side Meta Conversions API — the free dataset's pixel + token. All four
# free-funnel events fire through these: AddToCart (LP CTA), CompleteRegistration
# (form done), QualifiedLead (Q7 = yes, custom event), Schedule (Calendly booked).
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=


# ------------------------------------------------------- PAYMENTS (UNUSED)
# The funnel is free by application, so /checkout is hidden and nothing below
# is read at runtime. Kept documented so a paid step can be restored quickly.
# PRICE_INR=499
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_WEBHOOK_SECRET=
# PABBLY_WEBHOOK_URL=
